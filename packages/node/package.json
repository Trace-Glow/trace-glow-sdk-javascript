{
  "name": "@trace-glow-internal/node",
  "private": true,
  "version": "0.1.0",
  "description": "Node.js monitoring and web framework adapters for Trace Glow",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": { "@trace-glow-internal/core": "workspace:*" },
  "devDependencies": { "@types/node": "^22.18.0" }
}
